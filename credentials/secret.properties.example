# =====================================================================
# MOVE:ON 접속 정보 예시 파일
#
# [팀원이 할 일]
#   1. 이 파일을 복사해서 같은 폴더에 secret.properties 라는 이름으로 저장
#   2. 아래 값들을 팀장에게 받아서 = 뒤에 채우기
#   3. secret.properties 는 .gitignore 에 걸려 있어 GitHub 에 올라가지 않는다.
#      실제 비밀번호가 들어가는 파일이니 절대 커밋하지 말 것
#
# 이 파일(.example)에는 값을 적지 않는다. 키 이름만 알려주는 용도다.
# 나중에 설정이 늘어나면 여기에도 키를 추가해서 팀에 공유한다.
# =====================================================================

# DB (MariaDB)
spring.datasource.url=jdbc:mariadb://서버주소:3306/moveon
spring.datasource.username=
spring.datasource.password=
spring.datasource.driver-class-name=org.mariadb.jdbc.Driver

# Mail (회원가입 인증번호 발송에 쓰는 계정)
# 네이버 메일 기준. 메일 환경설정에서 'SMTP 사용'을 켜야 발송된다
spring.mail.username=
spring.mail.password=

# 외부 API
kakao.map.key=
