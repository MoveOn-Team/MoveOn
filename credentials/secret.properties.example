# 이 파일을 복사해서 secret.properties 로 저장하고 값을 채울 것 (커밋 금지)

# DB (각자 자기 VM)
spring.datasource.url=jdbc:mariadb://본인VM주소:3306/moveon
spring.datasource.username=
spring.datasource.password=
spring.datasource.driver-class-name=org.mariadb.jdbc.Driver

# 인증번호 발송용 메일 계정 (네이버 SMTP 사용 설정 필요)
spring.mail.username=
spring.mail.password=

# 서울 열린데이터광장 인증키 - 공공체육시설 강좌 수집
seoul.api.key=

# 카카오 REST API 키 - 서버에서 좌표 조회 (노출 금지)
kakao.rest.key=

# 카카오 JavaScript 키 - 화면 지도 표시 (콘솔에 도메인 등록 필요)
kakao.map.key=
